FROM tempcast-lk10-model:latest

WORKDIR /app

RUN python -m pip install --no-cache-dir \
    -r /opt/ml/model/requirements.txt \
    "prometheus-client>=0.21,<1"

COPY src/monitored_model.py /app/monitored_model.py

EXPOSE 8080

ENTRYPOINT ["python", "-m", "uvicorn"]

CMD ["monitored_model:app", "--host", "0.0.0.0", "--port", "8080"]